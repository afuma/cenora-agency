{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nom complet du prospect"
    },
    "email": {
      "type": "string",
      "description": "Adresse email"
    },
    "phone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "company": {
      "type": "string",
      "description": "Nom de l'entreprise"
    },
    "service": {
      "type": "string",
      "enum": [
        "site_creation",
        "site_redesign",
        "seo",
        "local_seo",
        "branding",
        "other"
      ],
      "description": "Service demand\u00e9"
    },
    "message": {
      "type": "string",
      "description": "Message du prospect"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "audit",
        "call",
        "quote"
      ],
      "default": "audit",
      "description": "Type de demande"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "converted",
        "lost"
      ],
      "default": "new",
      "description": "Statut du lead"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}